{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["es2017"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@bplus/types": ["../../packages/types/index"],
      "@bplus/ui": ["../../packages/ui/src/index"]
    }
  },
  "include": ["src/**/*", "App.tsx"]
}
